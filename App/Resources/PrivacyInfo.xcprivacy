<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing leaves the device except to the phones you share a match with, so there is
	     nothing collected in Apple's sense: no server, no analytics, no third party.
	     A recorded workout is no exception. It is written to Health on the wrist and its
	     summary sent to that one paired phone, and Apple's definition of collecting is
	     transmitting off the device somewhere the developer can reach — which is nowhere
	     here. Declaring it would put "Health & Fitness" on the product page in exchange for
	     a claim that is not true. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<!-- CA92.1: defaults readable and writable only by this app. Every use qualifies —
			     the announcer's toggle, voice and speed, the full-screen blackout, and the
			     per-install device id — and
			     none of them goes through an app group. -->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
